{
  "name": "@broadnet/shortener",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript client for the BN Shortener API (b1.lc): links, QR codes, bio pages, analytics, webhooks, OAuth",
  "license": "MIT",
  "author": {
    "name": "BroadNet Technologies LLC",
    "email": "support@broadnet.me",
    "url": "https://b1.lc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BN-Shortner/bn-shortener-js.git"
  },
  "bugs": {
    "url": "https://github.com/BN-Shortner/bn-shortener-js/issues",
    "email": "support@broadnet.me"
  },
  "homepage": "https://b1.lc/docs/",
  "keywords": [
    "url shortener",
    "short links",
    "qr codes",
    "b1.lc",
    "broadnet"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
