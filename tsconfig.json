{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "outDir": "dist/esm",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"]
}
